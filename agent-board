#!/usr/bin/env python3
"""Thin shim for direct-script (git clone) usage.

Delegates to claude_browse.board subcommands. When installed via
`pip install`, an entry point in pyproject.toml can replace this shim --
until then, install.sh symlinks it into ~/.local/bin/agent-board.
"""

import os
import sys

# Resolve the symlink so the shim still finds the package when install.sh
# links it into ~/.local/bin/
_HERE = os.path.dirname(os.path.realpath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)


def main() -> None:
    if len(sys.argv) < 2:
        print(
            "usage: agent-board <hook|statusline|board|sync|ack|direct-session>",
            file=sys.stderr,
        )
        sys.exit(1)

    subcommand = sys.argv[1]

    if subcommand == "hook":
        from claude_browse.board.hook import main as hook_main

        hook_main()
    elif subcommand == "statusline":
        from claude_browse.board.statusline import main as statusline_main

        statusline_main()
    elif subcommand in ("board", "jobs"):
        from claude_browse.board.cli import main as cli_main

        cli_main()
    elif subcommand == "sync":
        from claude_browse.board.sync import main as sync_main

        sync_main(sys.argv[2:])
    elif subcommand == "ack":
        from claude_browse.board.sync import main as sync_main

        sync_main(["ack", *sys.argv[2:]])
    elif subcommand == "direct-session":
        from claude_browse.board.commands import launch_direct_session

        args = sys.argv[2:]
        if len(args) != 3 or args[2] not in {"true", "false"}:
            print(
                "usage: agent-board direct-session SESSION_ID PROVIDER true|false",
                file=sys.stderr,
            )
            sys.exit(2)
        try:
            launch_direct_session(args[0], args[1], full_access=args[2] == "true")
        except (OSError, ValueError) as exc:
            print(f"agent-board: {exc}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"unknown subcommand: {subcommand}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
